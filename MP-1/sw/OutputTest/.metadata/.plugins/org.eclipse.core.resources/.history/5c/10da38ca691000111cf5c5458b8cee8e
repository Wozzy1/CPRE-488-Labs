/*
 * helloworld.c: simple test application
 *
 * This application configures UART 16550 to baud rate 9600.
 * PS7 UART (Zynq) is not initialized by this application, since
 * bootrom/bsp configures it to baud rate 115200
 *
 * ------------------------------------------------
 * | UART TYPE   BAUD RATE                        |
 * ------------------------------------------------
 *   uartns550   9600
 *   uartlite    Configurable only in HW design
 *   ps7_uart    115200 (configured by bootrom/bsp)
 */

#include <stdio.h>
#include "platform.h"
#include "xil_printf.h"
#include "xparameters.h"
#include "xil_io.h"
#include "sleep.h"

#define PPM_BASE XPAR_AXI_PPM4_0_S00_AXI_BASEADDR

#define REG0   0x00
#define REG1   0x04

/* SW0 comes from AXI GPIO channel 1, bit 0. */
#define SW0_MASK 0x1U

#if defined(XPAR_AXI_GPIO_1_DEVICE_ID)
#define SW_GPIO_DEVICE_ID XPAR_AXI_GPIO_1_DEVICE_ID
#elif defined(XPAR_GPIO_1_DEVICE_ID)
#define SW_GPIO_DEVICE_ID XPAR_GPIO_1_DEVICE_ID
#elif defined(XPAR_AXI_GPIO_0_DEVICE_ID)
#define SW_GPIO_DEVICE_ID XPAR_AXI_GPIO_0_DEVICE_ID
#elif defined(XPAR_GPIO_0_DEVICE_ID)
#define SW_GPIO_DEVICE_ID XPAR_GPIO_0_DEVICE_ID
#endif

int main()
{
    XGpio gpio;
    int status;
    int last_sw0 = -1;

    init_platform();

    print("AXI PPM relay mode by SW0\r\n");

    status = XGpio_Initialize(&gpio, SW_GPIO_DEVICE_ID);
    if (status != XST_SUCCESS) {
        xil_printf("AXI GPIO init failed for SW0.\r\n");
        cleanup_platform();
        return 1;
    }
    XGpio_SetDataDirection(&gpio, 1, 0xFFFFFFFFU); /* channel 1 input */

    while (1) {
        u32 sw_data = XGpio_DiscreteRead(&gpio, 1);
        int sw0 = ((sw_data & SW0_MASK) != 0U) ? 1 : 0;

        if (sw0 != last_sw0) {
            if (sw0 == 0) {
                Xil_Out32(PPM_BASE + REG0, 0U);  /* hardware relay */
                xil_printf("SW0=0 -> hardware relay (REG0=%u)\r\n",
                           (unsigned long)Xil_In32(PPM_BASE + REG0));
            } else {
                Xil_Out32(PPM_BASE + REG0, 1U);  /* software relay */
                Xil_Out32(PPM_BASE + REG1, 1U);  /* software output bit for current RTL */
                xil_printf("SW0=1 -> software relay (REG0=%u)\r\n",
                           (unsigned long)Xil_In32(PPM_BASE + REG0));
            }
            last_sw0 = sw0;
        }

        usleep(10000);
    }

    cleanup_platform();
    return 0;
}
