// Main function. Performs Xilinx-specific initialization, and then goes into the main polling loop
int main() {

	// Initialize all memory space
	xil_init();

	// initialize two additional buttons
//	ps_gpio_init();

	// Initialize the NESCore
	NESCore_Init();


	// Enable the cache
    Xil_DCacheEnable();


    // Main polling loop. For now, you can hard-code the .nes ROM you would like to load.
    // Later, improve the code to have user-specified entry and exit options
	while (1) {
		nes_load();
	}

}


// returns first index of the given char
// else returns 0
int str_find(const char* str, size_t len, char c) {
	int index;
	for (index = 0; index < len; index++) {
		if (str[index] == c) {
			return index;
		}
	}
	return -1;
}

// returns 1 if given file is .NES
// else returns 0
int is_nes(FILINFO *file) {
	const char *name = (const char *)file->fname;
	size_t len = strlen(name);
	int dot_index = str_find(name, len, '.');
	if (dot_index == -1) {
//		xil_printf("is_nes(): file %s did not have extension wtf not our fault\r\n", (char*)file->fname);
		return 0;
	}
	if (tolower((unsigned char)name[dot_index + 1]) == 'n' &&
	    tolower((unsigned char)name[dot_index + 2]) == 'e' &&
	    tolower((unsigned char)name[dot_index + 3]) == 's' &&
	    name[dot_index + 4] == '\0') {
	    return 1;
	}
	else {
		return 0;
	}
}

void read_games(char *sel) {
	DIR directory;
	FILINFO file;
	FATFS fs;
	FRESULT result;

	// mount to drive
	result = f_mount(0, &fs);
	if (result != FR_OK) {
		xil_printf("display_games(): failed to mount to fs, error: %d\r\n", result);
	}
	xil_printf("display_games(): mounted to file system\r\n");

	// open directory
	result = f_opendir(&directory, "");
	if (result != FR_OK) {
		xil_printf("display_games(): failed to open directory, error: %d\r\n", result);
	}
	xil_printf("display_games(): opened directory\r\n");

	// read directory
	result = f_readdir(&directory, &file);
	if (result != FR_OK || !file.fname) {
		xil_printf("display_games(): failed to read directory, error: %d\r\n", result);
	}
	xil_printf("display_games(): read the system file %s\r\n", file.fname);

	char games[130][MAX_GAME_NAME_LENGTH];
//	int game_index = 0;


	while (1) {
		result = f_readdir(&directory, &file);
		if (result != FR_OK || file.fname[0] == '\0') {
			break;
		}

		if (is_nes(&file)) {
		    const char* name = file.fname;
		    const char* dot = strrchr(name, '.');

		    size_t length = (size_t)(dot - name);

		    if (length >= MAX_GAME_NAME_LENGTH) {
		        length = MAX_GAME_NAME_LENGTH - 1;
		    }

		    strncpy(games[NUM_GAMES], name, length);

		    games[NUM_GAMES][length] = '\0';

		    NUM_GAMES++;
		}
	}

	uint32_t previous_buttons = Xil_In32((UINTPTR)XPAR_AXI_GPIO_1_BASEADDR);
	display_page_(PAGE_INDEX * 10, PAGE_INDEX * 10 + 10, games);
	while (SELECTING_GAME) {
		// read buttons
		uint32_t buttons = Xil_In32((UINTPTR)XPAR_AXI_GPIO_1_BASEADDR);


		if (previous_buttons != buttons) {
			// compute new pages based on change
			if ((buttons & 0b1)) {
//				xil_printf("Start pressed\n\r");
//				nes_strncpy((uint8_t*)sel, games[GAME_INDEX], strlen(games[GAME_INDEX)));
				xil_printf("SEL0 GAME_NAME: %s\r\n", sel);
				xil_printf("GAME_INDEX: %d\r\n", GAME_INDEX);
				xil_printf("GAME_NAME: %s\r\n", games[GAME_INDEX]);


				size_t final_length = strlen(games[GAME_INDEX]);
				char final_game[MAX_GAME_NAME_LENGTH];
				strcpy(final_game, games[GAME_INDEX]);
				nes_strncpy(sel, games[GAME_INDEX], strlen(games[GAME_INDEX]));

				xil_printf("SEL GAME_NAME: %s\r\n", sel);
				break;
			}
			if ((buttons & 0b10)) {
//				xil_printf("Down pressed\n\r");
				if (GAME_INDEX < PAGE_INDEX * 10 + 9) {
					GAME_INDEX++;
				}
			}
			if ((buttons & 0b100)) {
//				xil_printf("Left pressed\n\r");
				if (PAGE_INDEX > 0) {
					PAGE_INDEX--;
					GAME_INDEX = PAGE_INDEX * 10 - 9;
				}

			}
			if ((buttons & 0b1000)) {
//				xil_printf("Right pressed\n\r");
				if (PAGE_INDEX < NUM_GAMES / 10) {
					PAGE_INDEX++;
					GAME_INDEX = PAGE_INDEX * 10;
				}
			}
			if ((buttons & 0b10000)) {
//				xil_printf("Up pressed\n\r");

				if (GAME_INDEX > PAGE_INDEX * 10) {
					GAME_INDEX--;

				}
			}

			// then display
			display_page_(PAGE_INDEX * 10, PAGE_INDEX * 10 + 10, games);

		}
		usleep(150000);
	}


//	xil_printf("====================\r\n");
//	xil_printf("     SELECT GAME    \r\n");
//	for (int i = 0; i < game_index; i++) {
//		xil_printf("%s\r\n", games[i]);
//	}

	// create visual screen loop for selecting games
	// something like
	// use dpad to move between options, have a function to print out a new page with the updated cursor position

}

void display_page_(int start, int end, char games[130][MAX_GAME_NAME_LENGTH]) {
	xil_printf("====================\r\n");
	xil_printf("     SELECT GAME    \r\n");
	if (end > NUM_GAMES) {
		end = NUM_GAMES;
	}
	for (int i = start; i < end; i++) {
		if (i == GAME_INDEX) {
			xil_printf(">  [%3d] %s  <\r\n", i, games[i]);
		}
		else {
			xil_printf("[%3d] %s\r\n", i, games[i]);
		}
	}
}


